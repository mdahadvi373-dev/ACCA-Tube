// Withdraw Form Handler
document.addEventListener('DOMContentLoaded', () => {
    const withdrawForm = document.getElementById('withdraw-form');
    if (withdrawForm) {
        withdrawForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            if (!currentUser || !userData) return;

            const amount = parseFloat(document.getElementById('withdraw-amount').value);
            const method = document.querySelector('input[name="method"]:checked')?.value;
            const account = document.getElementById('withdraw-account').value;

            if (!amount || !method || !account) {
                showError('Error', 'Please fill all fields');
                return;
            }

            if (amount < PLATFORM.minWithdrawal) {
                showError('Error', `Minimum withdrawal is AED ${PLATFORM.minWithdrawal}`);
                return;
            }

            if (amount > userData.balance) {
                showError('Error', 'Insufficient balance');
                return;
            }

            try {
                showToast('Processing withdrawal...');

                const result = await requestWithdrawal(currentUser.uid, amount, method, account);

                if (result.success) {
                    userData.balance -= amount;
                    updateDashboard();

                    showSuccess(
                        'Withdrawal Requested',
                        `Your withdrawal of AED ${amount} has been submitted`,
                        ''
                    );

                    withdrawForm.reset();
                    loadWithdrawPage();
                } else {
                    showError('Withdrawal Failed', result.error || 'Could not process withdrawal');
                }
            } catch (error) {
                console.error('Withdrawal error:', error);
                showError('Error', 'Could not process withdrawal');
            }
        });
    }
});

