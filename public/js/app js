// Start Task
function startTask(taskId, taskType) {
    if (!currentUser) {
        showError('Login Required', 'Please login to complete tasks');
        return;
    }

    let task = null;
    if (taskType === 'ad') {
        task = ADS_DATA.find(t => t.id === taskId);
    } else if (taskType === 'survey') {
        task = SURVEYS_DATA.find(t => t.id === taskId);
    } else if (taskType === 'game') {
        task = GAMES_DATA.find(t => t.id === taskId);
    }

    if (!task) return;

    currentTask = { ...task, type: taskType };

    // Show task modal
    const modal = document.getElementById('task-modal');
    document.getElementById('task-modal-title').textContent = task.title;
    document.getElementById('task-timer').textContent = task.duration;
    document.getElementById('task-reward-amount').textContent = `AED ${task.reward.toFixed(2)}`;

    // Reset progress
    const progress = document.getElementById('timer-progress');
    progress.style.strokeDashoffset = '0';

    modal.classList.remove('hidden');

    // Start timer
    startTaskTimer(task.duration);
}

let taskTimer = null;
let currentTask = null;

function startTaskTimer(duration) {
    let remaining = duration;
    const total = duration;
    const progress = document.getElementById('timer-progress');
    const circumference = 2 * Math.PI * 54;

    progress.style.strokeDasharray = circumference;
    progress.style.strokeDashoffset = circumference;

    taskTimer = setInterval(() => {
        remaining--;

        document.getElementById('task-timer').textContent = remaining;

        // Update progress
        const offset = circumference - (remaining / total) * circumference;
        progress.style.strokeDashoffset = offset;

        if (remaining <= 0) {
            clearInterval(taskTimer);
            completeTask();
        }
    }, 1000);
}

function cancelTask() {
    if (taskTimer) {
        clearInterval(taskTimer);
        taskTimer = null;
    }
    document.getElementById('task-modal').classList.add('hidden');
    currentTask = null;
}

function closeTaskModal() {
    cancelTask();
}

async function completeTask() {
    if (!currentTask || !currentUser) return;

    document.getElementById('task-modal').classList.add('hidden');

    try {
        showToast('Verifying task...');

        const result = await addEarning(
            currentUser.uid,
            currentTask.type,
            currentTask.id,
            currentTask.reward
        );

        if (result.success) {
            // Update local data
            if (DEMO_MODE || result.newBalance) {
                userData.balance = parseFloat(result.newBalance || result.earned);
                userData.totalEarned += parseFloat(result.earned);

                if (currentTask.type === 'ad') userData.adsWatched++;
                else if (currentTask.type === 'survey') userData.surveysCompleted++;
                else if (currentTask.type === 'game') userData.gamesCompleted++;

                userData.tasksCompleted++;
            }

            updateDashboard();

            showSuccess(
                'Task Completed!',
                `You earned AED ${currentTask.reward.toFixed(2)}`,
                `+AED ${result.earned || currentTask.reward.toFixed(2)}`
            );
        } else {
            showError('Verification Failed', result.error || 'Task could not be verified');
        }
    } catch (error) {
        console.error('Task completion error:', error);
        showError('Error', 'Could not complete task. Please try again.');
    }

    currentTask = null;
}

